# Production settings for docker-compose.prod.yml (docs/operations/deployment.md).
# Copy to .env.production (git-ignored) and replace every value marked CHANGE.

# Image tag published by the release workflow (e.g. 1.4.0 or sha-1a2b3c4).
MENTORA_VERSION=latest
# Public URL of the web app (also the CORS origin and the base of email links).
APP_URL=https://mentora.example.com
PUBLIC_PORT=8080
PUBLIC_BIND=127.0.0.1
TRUST_PROXY=2

# Secrets. Generate each with: openssl rand -base64 48
JWT_SECRET=CHANGE-at-least-32-random-characters
MONGO_ROOT_PASSWORD=CHANGE
MONGO_APP_PASSWORD=CHANGE
MONGO_BACKUP_PASSWORD=CHANGE

# Email (ADR-0027): a real SMTP relay, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=CHANGE
MAIL_FROM=Mentora <no-reply@mentora.example.com>

# WhatsApp (ADR-0030) and video calls (ADR-0031). Local defaults need no account.
WHATSAPP_PROVIDER=local
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MEETING_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Backups (ADR-0039): a dump every N hours, kept for N days, in BACKUP_DIR on the host.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
