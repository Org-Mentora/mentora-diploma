{
  "name": "mentora",
  "private": true,
  "description": "Mentora monorepo: Express API (MVP) + Vite React web (MVVM)",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "codegen:check": "pnpm codegen && git diff --exit-code -- packages/contracts apps/web/src/model/api/generated",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "turbo": "2.11.8",
    "typescript": "6.0.3"
  }
}
