{
  "name": "mentora",
  "private": true,
  "description": "Mentora monorepo: Express API (MVP) + Vite React web (MVVM)",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "codegen:check": "pnpm codegen && git diff --exit-code -- packages/contracts apps/web/src/model/api/generated",
    "lint": "biome check . && pnpm lint:comments",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "lint:comments": "node tools/comments/check-comments.mjs",
    "smoke": "node tools/smoke/smoke.mjs",
    "db:backup": "node tools/db/backup.mjs",
    "db:restore": "node tools/db/restore.mjs",
    "docs:classes": "node tools/docs/class-diagram.mjs",
    "docs:check": "node tools/docs/class-diagram.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "lefthook": "2.2.2",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
