{
  "openapi": "3.0.3",
  "info": {
    "title": "Mentora API",
    "version": "0.1.0",
    "description": "REST API of the Mentora platform. Generated from zod contracts."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "uptimeSeconds": {
            "type": "integer",
            "example": 42
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentHealthDto"
            }
          }
        },
        "required": [
          "status",
          "uptimeSeconds",
          "checkedAt",
          "components"
        ],
        "description": "Aggregated service health"
      },
      "ComponentHealthDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "mongodb"
          },
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "integer",
            "nullable": true,
            "example": 3
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "name",
          "status",
          "latencyMs",
          "error"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "NOT_FOUND"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "nullable": true
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "description": "Body returned by every failed request"
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Report service and dependency health",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Health report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        }
      }
    }
  }
}
