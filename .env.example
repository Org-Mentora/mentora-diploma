# API
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/mentora
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Auth (ADR-0018). JWT_SECRET is required in production (min 32 chars).
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
SESSION_TTL_SECONDS=28800
# Free trial length for new professionals (CU-03)
TRIAL_DAYS=14
