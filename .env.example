# API
NODE_ENV=development
PORT=3000
# Must point to a replica set (transactions, ADR-0025). `docker compose up -d mongo` starts one.
MONGO_URI=mongodb://localhost:27017/mentora?directConnection=true
MONGO_MAX_POOL_SIZE=20
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Auth (ADR-0018). JWT_SECRET is required in production (min 32 chars).
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
SESSION_TTL_SECONDS=28800
# Free trial length for new professionals (CU-03)
TRIAL_DAYS=14

# Web app URL used in email links
APP_URL=http://localhost:5173
APP_TIMEZONE=America/Argentina/Buenos_Aires
# Background jobs: reminders, automatic inactivation, renewals (ADR-0026)
SCHEDULER_ENABLED=true

# Email (ADR-0027). `docker compose up -d mailpit` → inbox at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Mentora <no-reply@mentora.local>

# WhatsApp (ADR-0030): `local` logs and records messages; `cloud-api` needs a Meta account
WHATSAPP_PROVIDER=local
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Video calls (ADR-0031): `jitsi` needs no account; `google-meet` needs OAuth credentials
MEETING_PROVIDER=jitsi
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Plans in ARS (ADR-0029). Payments use the local simulated gateway (test cards in docs).
PLAN_MONTHLY_PRICE=25000
PLAN_ANNUAL_PRICE=250000

# Hardening (ADR-0037). Limits on login, registration and password recovery.
RATE_LIMIT_ENABLED=true
# Number of proxies in front of the API (1 behind the web nginx), for client IPs.
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000

# Demo data (ADR-0043). `docker compose up` loads a demo professional with patients, records,
# appointments and a card through the public API; `pnpm seed` does the same against `pnpm dev`.
SEED_DEMO_DATA=true
DEMO_EMAIL=demo@mentora.test
DEMO_PASSWORD=Demo1234
