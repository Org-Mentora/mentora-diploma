{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/*.generated.ts",
      "!**/model/api/generated",
      "!packages/contracts/openapi.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": ["./tools/biome/singleton-private-constructor.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": "error"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "complexity": {
        "noStaticOnlyClass": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/api/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/infrastructure/config/AppConfig.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "mongoose": "[arch] core/ is framework-agnostic. Persistence belongs to infrastructure/ (ADR-0004).",
                  "pino": "[arch] core/ depends on the AppLogger interface, not on pino (ADR-0007)."
                },
                "patterns": [
                  {
                    "group": ["#infrastructure/**", "#modules/**"],
                    "message": "[arch] core/ cannot depend on infrastructure/ or modules/ (ADR-0004)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["#modules/**"],
                    "message": "[arch] Shared infrastructure must not know feature modules (ADR-0004)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/modules/*/model/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "express": "[arch][MVP] The Model is transport-agnostic (ADR-0004).",
                  "mongoose": "[arch][MVP] The Model declares abstract repositories; Mongoose lives in infrastructure/ (ADR-0007).",
                  "zod": "[arch][MVP] Input validation is a View concern; the Model enforces invariants in code (ADR-0004)."
                },
                "patterns": [
                  {
                    "group": [
                      "../presenter",
                      "../presenter/**",
                      "../view",
                      "../view/**",
                      "../contracts/**",
                      "../infrastructure/**",
                      "#infrastructure/**",
                      "#core/presenter/**",
                      "#core/view/**",
                      "#core/module/**",
                      "#core/contracts/**"
                    ],
                    "message": "[arch][MVP] The Model must not depend on Presenter, View, contracts or infrastructure (ADR-0004)."
                  },
                  {
                    "group": ["../../**"],
                    "message": "[arch] Do not reach into other modules; import their public index via #modules/<name> (ADR-0004)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/modules/*/presenter/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "express": "[arch][MVP] Presenters never touch HTTP; they talk to a View interface (ADR-0004).",
                  "mongoose": "[arch][MVP] Presenters use the Model, never the database (ADR-0004)."
                },
                "patterns": [
                  {
                    "group": [
                      "../view",
                      "../view/**",
                      "../infrastructure/**",
                      "#infrastructure/**",
                      "#core/view/Http*"
                    ],
                    "message": "[arch][MVP] Presenters depend on the Model and on View interfaces only (ADR-0004)."
                  },
                  {
                    "group": ["../../**"],
                    "message": "[arch] Do not reach into other modules; import their public index via #modules/<name> (ADR-0004)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/modules/*/view/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "mongoose": "[arch][MVP] Passive Views never access persistence (ADR-0004)."
                },
                "patterns": [
                  {
                    "group": [
                      "../model",
                      "../model/**",
                      "../infrastructure/**",
                      "#infrastructure/database/**",
                      "#infrastructure/logger/**",
                      "#infrastructure/config/**"
                    ],
                    "message": "[arch][MVP] Passive Views only know Presenters and contracts, never the Model (ADR-0004)."
                  },
                  {
                    "group": ["../../**"],
                    "message": "[arch] Do not reach into other modules; import their public index via #modules/<name> (ADR-0004)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/modules/*/infrastructure/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "express": "[arch] Persistence adapters are transport-agnostic (ADR-0007)."
                },
                "patterns": [
                  {
                    "group": ["../presenter", "../presenter/**", "../view", "../view/**"],
                    "message": "[arch] Adapters implement Model abstractions; they never see Presenters or Views (ADR-0007)."
                  },
                  {
                    "group": ["../../**"],
                    "message": "[arch] Do not reach into other modules; import their public index via #modules/<name> (ADR-0004)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/api/src/modules/*/contracts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "express": "[arch] Contracts are pure zod schemas (ADR-0009).",
                  "mongoose": "[arch] Contracts are pure zod schemas (ADR-0009)."
                },
                "patterns": [
                  {
                    "group": [
                      "../model",
                      "../model/**",
                      "../presenter/**",
                      "../view/**",
                      "../infrastructure/**",
                      "#infrastructure/**"
                    ],
                    "message": "[arch] Contracts describe the wire format only and depend on nothing else (ADR-0009)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/*/view/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@reduxjs/toolkit": "[arch][MVVM] Views bind to their ViewModel, never to the store (ADR-0011).",
                  "react-redux": "[arch][MVVM] Views bind to their ViewModel, never to the store (ADR-0011).",
                  "@mentora/contracts": "[arch][MVVM] Views render UI models exposed by the ViewModel, not DTOs (ADR-0011)."
                },
                "patterns": [
                  {
                    "group": ["@/model/**", "@reduxjs/toolkit/**", "@/app/store/**"],
                    "message": "[arch][MVVM] Views may only import their ViewModel, shared/ui and shared/lib (ADR-0011)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "[arch] Import other features through their public index (@/features/<name>) (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/*/viewmodel/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-dom": "[arch][MVVM] ViewModels expose state and commands; rendering is the View's job (ADR-0011).",
                  "@/model/api/baseApi": "[arch] Use the generated hooks from @/model/api/generated (ADR-0010)."
                },
                "patterns": [
                  {
                    "group": ["../view", "../view/**", "@/shared/ui/**"],
                    "message": "[arch][MVVM] ViewModels must not import Views or UI components (ADR-0011)."
                  },
                  {
                    "group": ["@/features/*/**"],
                    "message": "[arch] Import other features through their public index (@/features/<name>) (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/model/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-dom": "[arch][MVVM] The Model has no UI (ADR-0011).",
                  "react-router": "[arch][MVVM] Navigation belongs to Views/ViewModels (ADR-0011)."
                },
                "patterns": [
                  {
                    "group": ["@/features/**", "@/shared/ui/**", "@/app/**"],
                    "message": "[arch][MVVM] The Model must not depend on features, UI or the app shell (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/model/**", "@/app/**"],
                    "message": "[arch] shared/ is generic and cannot depend on features, model or app (ADR-0011)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/**", "apps/web/src/shared/**", "apps/web/src/app/**"],
      "plugins": ["./tools/biome/no-fetch-outside-model.grit"]
    }
  ]
}
