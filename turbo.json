{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "BASE_URL",
    "SMOKE_WAIT_SECONDS",
    "BACKUP_DIR",
    "MONGO_DATABASE",
    "SEED_BASE_URL",
    "SEED_DEMO_DATA",
    "SEED_WAIT_SECONDS",
    "DEMO_EMAIL",
    "DEMO_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "openapi:generate": {
      "cache": false
    },
    "generate": {
      "dependsOn": ["@mentora/api#openapi:generate"],
      "cache": false
    },
    "codegen": {
      "dependsOn": ["@mentora/contracts#generate"],
      "cache": false
    }
  }
}
